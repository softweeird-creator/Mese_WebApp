{
  "name": "mese-servidor",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor de MESE: inicio de sesión y API sobre la base de datos MySQL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clave": "tsx src/clave.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
