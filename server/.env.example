# Copie este archivo como .env y ajuste los valores.
PUERTO=3000
# En producción (con HTTPS) ponga produccion: la cookie de sesión solo viaja cifrada.
MODO=desarrollo
# Ponga si cuando el servidor esté detrás de un proxy con HTTPS (nginx, Caddy...).
PROXY=no
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=mese_app
DB_CLAVE=CAMBIE_ESTA_CONTRASENA_1
DB_NOMBRE=mese
